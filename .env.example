# Copy to .env.local and fill in. Never commit .env.local.

# --- Database ---------------------------------------------------------------
# Local Docker (see README → Database):
#   docker run -d --name gatherflow-pg \
#     -e POSTGRES_USER=gatherflow -e POSTGRES_PASSWORD=gatherflow \
#     -e POSTGRES_DB=gatherflow -p 5466:5432 postgres:17-alpine
DATABASE_URL=postgres://gatherflow:gatherflow@localhost:5466/gatherflow

# Set to run the database integration tests. Point it at a THROWAWAY database:
# the tests create and delete churches. Leave unset and those tests skip.
TEST_DATABASE_URL=postgres://gatherflow:gatherflow@localhost:5466/gatherflow

# --- Authentication ---------------------------------------------------------
# Signing secret for sessions. Generate one per environment; never reuse the
# development value anywhere real:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# Public origin of the app. Without it the origin is taken from the incoming
# request, which makes callbacks and redirects unreliable.
BETTER_AUTH_URL=http://localhost:3000
