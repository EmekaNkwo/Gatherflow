# Copy to .env.local and fill in. Never commit .env.local.

# --- Database ---------------------------------------------------------------
# Local Docker (see README → Database):
#   docker run -d --name gatherflow-pg \
#     -e POSTGRES_USER=gatherflow -e POSTGRES_PASSWORD=gatherflow \
#     -e POSTGRES_DB=gatherflow -p 5466:5432 postgres:17-alpine
DATABASE_URL=postgres://gatherflow:gatherflow@localhost:5466/gatherflow

# Set to run the database integration tests. Point it at a THROWAWAY database:
# the tests create and delete churches. Leave unset and those tests skip.
TEST_DATABASE_URL=postgres://gatherflow:gatherflow@localhost:5466/gatherflow

# --- Authentication ---------------------------------------------------------
# Signing secret for sessions. Generate one per environment; never reuse the
# development value anywhere real:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# Public origin of the app. Without it the origin is taken from the incoming
# request, which makes callbacks and redirects unreliable.
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Mailjet) --------------------------------------------------------
# Leave unset and the application simply does not offer to send: drafting,
# copying and handing a message to another app all still work.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=hello@yourchurch.example
MAILJET_FROM_NAME=Your Church

# The production gate. Credentials make sending *possible*; this makes the
# interface *offer* it. Keep it off until docs/email-production-runbook.md has
# been worked through for this deployment.
EMAIL_SENDING_ENABLED=false

# A controlled pilot: while set, only these addresses can be emailed and every
# other recipient is refused before anything is queued. Comma-separated.
# Clear it to end the pilot.
EMAIL_PILOT_ALLOWLIST=

# Signs the unsubscribe link in every message, so a guessed person id cannot
# opt somebody else out. Falls back to BETTER_AUTH_SECRET when unset.
UNSUBSCRIBE_SECRET=

# Only for tests: point the worker at a stub instead of the real API.
# MAILJET_SEND_URL=http://localhost:3611/v3.1/send

# Mailjet does NOT sign its webhooks, so the secret in the callback path is the
# only thing distinguishing a real event from an invented one. Generate a long
# random value and keep it out of logs:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then point Mailjet's event callback at:
#   https://your-host/api/webhooks/mailjet/<MAILJET_WEBHOOK_SECRET>
MAILJET_WEBHOOK_SECRET=

# The operator secret: bearer token for the outbox drain, the daily reminders,
# the email health check, and church backup/restore (/api/ops/*). Never a
# role; never in a browser.
CRON_SECRET=

# --- Daily reminders (Web Push) ---------------------------------------------
# Lets people turn on a daily "follow-ups due" reminder that arrives with
# GatherFlow closed. Leave unset and the Account page says reminders are not
# set up. Generate the pair once, and keep the private key secret:
#   npx web-push generate-vapid-keys
# The subject is how a browser's push service can reach the operator.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@your-church.example
